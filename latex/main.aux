\newlabel{tab:criteria-auc}{{4}{16}{ROC-AUC (uniform vs.\ shape), averaged over $d\in \{2,5,10,15,20\}$, $n=400$, $R=60$ repeats per cell. Bold marks the best criterion per shape}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces ROC-AUC by shape and dimension for the three refinement criteria. Random projection's power on the two border-imbalance shapes visibly collapses toward chance as dimension grows, exactly as Theorem~\ref {thm:hoeffding}'s discussion predicts ($R(v)=\Theta (\sqrt  {d})$ weakens the bound); Weyl's power does not.}}{16}{figure.4}\protected@file@percent }
\newlabel{fig:criteria-auc}{{4}{16}{ROC-AUC by shape and dimension for the three refinement criteria. Random projection's power on the two border-imbalance shapes visibly collapses toward chance as dimension grows, exactly as Theorem~\ref {thm:hoeffding}'s discussion predicts ($R(v)=\Theta (\sqrt {d})$ weakens the bound); Weyl's power does not}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Empirical false-positive rate under true $H_0$ versus sample size $n$ (batch, no decay), $d=10$. $T_{\mathrm  {Weyl}}$ tracks its nominal $\alpha =0.05$ at every $n$; the random-projection criterion stays at or near $0$, strictly under its $\le \alpha $ bound; $R(g)$'s fixed threshold shows $0$ false positives here but is not calibrated in the same sense (see discussion above).}}{17}{figure.5}\protected@file@percent }
\newlabel{fig:criteria-calibration}{{5}{17}{Empirical false-positive rate under true $H_0$ versus sample size $n$ (batch, no decay), $d=10$. $T_{\mathrm {Weyl}}$ tracks its nominal $\alpha =0.05$ at every $n$; the random-projection criterion stays at or near $0$, strictly under its $\le \alpha $ bound; $R(g)$'s fixed threshold shows $0$ false positives here but is not calibrated in the same sense (see discussion above)}{figure.5}{}}
